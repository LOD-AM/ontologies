# ----------------------------------------------------------------------------
# ARCHAEOLOGICAL OBJECTS AND TYPES (CIDOC CRM)
# ----------------------------------------------------------------------------

:spearhead_1 a crm:E22_Man-Made_Object;
    a afm:AFM_0001099;
    afx:AFX_0001048 :sample_ARSL31A;
    crm:P148_has_component :spearhead_1_blade;
    crm:P148_has_component :spearhead_1_tange;
    crmarchaeo:A21_is_contained_in :Palace_Hoard;
    crm:P1_is_identified_by "T1 2*, y37";
    crm:P71_is_listed_in <https://doi.org/10.3406/paleo.2002.4745>;
    crm:P41_classified :assign_spearhead_1_type,
    :assign_spearhead_1_mat.

:spearhead_1_blade a crm:E22_Man-Made_Object;
    crm:P71_is_listed_in <https://doi.org/10.3406/paleo.2002.4745>;
    crm:P41_classified :assign_spearhead_1_blade_type,
    :assign_spearhead_1_blade_mat.

:spearhead_1_tange a crm:E22_Man-Made_Object;
    crm:P71_is_listed_in <https://doi.org/10.3406/paleo.2002.4745>;
    crm:P41_classified :assign_spearhead_1_tange_type,
    :assign_spearhead_1_tange_mat.

:assign_spearhead_1_type a crm:E17_Type_Assignment;
    crm:P2_has_type <http://vocab.getty.edu/page/aat/300037118>.

:assign_spearhead_1_mat a crm:E17_Type_Assignment;
    crm:P46_is_composed_of <http://vocab.getty.edu/page/aat/300241441>.

:assign_spearhead_1_blade_type a crm:E17_Type_Assignment;
    crm:P2_has_type :spearhead_blade.

:assign_spearhead_1_blade_mat a crm:E17_Type_Assignment;
    crm:P46_is_composed_of <http://vocab.getty.edu/page/aat/300241441>.

:assign_spearhead_1_tange_type a crm:E17_Type_Assignment;
    crm:P2_has_type :spearhead_tange.

:assign_spearhead_1_tange_mat a crm:E17_Type_Assignment;
    crm:P46_is_composed_of <http://vocab.getty.edu/page/aat/300241441>.

<http://vocab.getty.edu/page/aat/300241441> a crm:E57_Material ;
    crm:P71_is_listed_in <http://vocab.getty.edu/aat/>.

<http://vocab.getty.edu/page/aat/300037118> a crm:E99_Product_Type;
    crm:P71_is_listed_in <http://vocab.getty.edu/aat/>.

:spearhead_blade a crm:E99_Product_Type;
    crm:P71_is_listed_in <https://doi.org/10.3406/paleo.2002.4745>.

:spearhead_tange a crm:E99_Product_Type;
    crm:P71_is_listed_in <https://doi.org/10.3406/paleo.2002.4745>.

# ----------------------------------------------------------------------------
# SCIENTIFIC ANALYSIS (Allotrope Framework - AFO)
# ----------------------------------------------------------------------------

# ========== LABORATORY (ROR) ==========
:sapienza_lab a afo:Organization ;
    afo:identifier "02be6w209" ;
    afo:label "Sapienza University of Rome" ;
    afo:sameAs ror:02be6w209 .

:sample_ARSL31A a afm:AFM_0001099 ;
    afo:label "Sample from Spearhead 1 Blade (ARSL31A)" .

# ========== ANALYSIS ==========
:ARSL31A a afp:AFP_0000527 ;  # spectrometry (closest AFO match)
    afo:identifier "ARSL31A" ;
    afo:label "optical emission spectrometry with inductively-coupled plasma excitation (ICP Iris-AP)" ;
    afo:source <https://doi.org/10.3406/paleo.2002.4745>;
    afx:AFX_0000197 :sapienza_lab ;
    afx:AFX_0000395 :Cu_measurement, :Ag_measurement, :As_measurement, :Ni_measurement, :Sb_measurement, :Pb_measurement, :Fe_measurement, :Zn_measurement, :Co_measurement .

# ========== MEASUREMENTS ==========
:Cu_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:28694 ;  # Copper
    afo:value "97"^^xsd:decimal ;
    afo:unit "PERCENT" .

:Ag_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:23855 ;  # Silver
    afo:value "0.002"^^xsd:decimal ;
    afo:unit "PERCENT" .

:As_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:27563 ;  # Arsenic
    afo:value "3.11"^^xsd:decimal ;
    afo:unit "PERCENT" .

:Ni_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:28695 ;  # Nickel
    afo:value "0.002"^^xsd:decimal ;
    afo:unit "PERCENT" .

:Sb_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:28697 ;  # Antimony
    afo:value "0.007"^^xsd:decimal ;
    afo:unit "PERCENT" .

:Pb_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:28702 ;  # Lead
    afx:AFX_0000331 "0.001"^^xsd:decimal ;  # <0.001% (max only)
    afo:unit "PERCENT" .

:Fe_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:23377 ;  # Iron
    afo:value "0.008"^^xsd:decimal ;
    afo:unit "PERCENT" .

:Zn_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:27637 ;  # Zinc
    afx:AFX_0000331 "0.001"^^xsd:decimal ;  # <0.001% (max only)
    afo:unit "PERCENT" .

:Co_measurement a afr:AFR_0002036 ;
    afx:AFX_0002816 chebi:27659 ;  # Cobalt
    afx:AFX_0000331 "0.001"^^xsd:decimal ;  # <0.001% (max only)
    afo:unit "PERCENT" .

